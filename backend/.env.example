# --- Core ---
PORT=3001
MONGODB_URI=mongodb://localhost:27017/mymassrealestateagent
JWT_SECRET=change-me

# --- MLS PIN listing feed (RESO Web API via Bridge Data Output) ---
# Token is issued by MLS PIN once a data licence / IDX agreement is in place.
MLSPIN_ACCESS_TOKEN=
MLSPIN_API_URL=https://api.bridgedataoutput.com/api/v2/OData/mlspin
MLSPIN_PROPERTY_RESOURCE=Property
MLSPIN_STATE=MA
MLSPIN_STATUSES=Active,Coming Soon,Active Under Contract,Pending
MLSPIN_PAGE_SIZE=200
MLSPIN_MAX_PAGES_PER_RUN=1000
MLSPIN_EXPAND_MEDIA=true
MLSPIN_SYNC_ENABLED=true
MLSPIN_SYNC_INTERVAL_MINUTES=15

# --- Optional integrations ---
NEWSDATA_API_KEY=
SMTP_USER=
SMTP_PASS=
AGENT_EMAIL=
